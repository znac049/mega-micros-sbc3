# sbc3_glue.qsf - Quartus II 13.0sp1 settings for the SBC3 glue CPLD (IC3)
set_global_assignment -name FAMILY MAX7000S
# Change the speed grade to match the chip (-6, -7, -10 or -15).
set_global_assignment -name DEVICE EPM7128SLC84-15
set_global_assignment -name TOP_LEVEL_ENTITY sbc3_glue
set_global_assignment -name VERILOG_FILE sbc3_glue.v
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name MAX7000_ENABLE_JTAG_BST_SUPPORT ON

set_location_assignment PIN_83 -to clk2
set_location_assignment PIN_28 -to reset_n
set_location_assignment PIN_61 -to as1_n
set_location_assignment PIN_31 -to rw3
set_location_assignment PIN_58 -to siz[1]
set_location_assignment PIN_57 -to siz[0]
set_location_assignment PIN_65 -to fc[2]
set_location_assignment PIN_67 -to fc[1]
set_location_assignment PIN_68 -to fc[0]
