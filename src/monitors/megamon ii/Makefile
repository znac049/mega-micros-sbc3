CPU?=68030
ARCH?=$(CPU)
TUNE?=$(CPU)

VASMFLAGS=-m$(CPU) -quiet -Lnf $(DEFINES)

VASM=vasmm68k_mot

PROGRAM_BASENAME=megamon

# Set other output files using output basname
BINARY=$(PROGRAM_BASENAME).bin
SREC=$(PROGRAM_BASENAME).srec
BIN=$(PROGRAM_BASENAME).bin

# Assume source files in Makefile directory are source files for project
SOURCES=megamon.asm

# Assume each source files makes an object file
OBJECTS=$(addsuffix .o,$(basename $(SOURCES)))

TO_CLEAN=$(OBJECTS) $(BIN) $(SREC) *.map *.sym *.lst *.romlst

all: $(SREC) $(BIN)

$(OBJECTS): Makefile

%.srec : %.asm
	$(VASM) -D TargetIsROM=0 -Fsrec $(VASMFLAGS) $(EXTRA_VASMFLAGS) -L $(basename $@).lst -o $@ $<

%.bin : %.asm
	$(VASM) -D TargetIsROM=1 -Fbin $(VASMFLAGS) $(EXTRA_VASMFLAGS) -L $(basename $@).romlst -o $@ $<

# remove targets that can be generated by this Makefile
clean:
	$(RM) $(TO_CLEAN)

.PHONY: all clean
