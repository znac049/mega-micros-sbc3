ifndef MEGA_MICROS_DIR
$(error ERROR: MEGA_MICROS_DIR not set)
endif

-include $(MEGA_MICROS_DIR)/src/stdenv.mk
FLAGS:=$(FLAGS) -Wno-array-bounds
LDSCRIPT:=./rom.ld
PROGRAM_BASENAME:=rom_image
ELF:=$(PROGRAM_BASENAME).elf
BINARY:=$(PROGRAM_BASENAME).bin
SREC:=$(PROGRAM_BASENAME).srec
DISASM:=$(PROGRAM_BASENAME).dis
MAP:=$(PROGRAM_BASENAME).map
SYM:=$(PROGRAM_BASENAME).sym