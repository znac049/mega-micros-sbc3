/*
 * C++'s <new>: placement new, and std::nothrow for new that returns
 * nullptr instead of ending the program when memory runs out. new and
 * delete themselves are in the library (cxx/cxxrt.c).
 */

#pragma once

#include <stddef.h>

namespace std {
    struct nothrow_t {
        explicit nothrow_t() = default;
    };

    extern const nothrow_t nothrow;
}

void *operator new(size_t size, const std::nothrow_t &) noexcept;
void *operator new[](size_t size, const std::nothrow_t &) noexcept;
void operator delete(void *p, const std::nothrow_t &) noexcept;
void operator delete[](void *p, const std::nothrow_t &) noexcept;

// Placement new: make an object in memory that's already there
inline void *operator new(size_t, void *p) noexcept { return p; }
inline void *operator new[](size_t, void *p) noexcept { return p; }
inline void operator delete(void *, void *) noexcept { }
inline void operator delete[](void *, void *) noexcept { }
