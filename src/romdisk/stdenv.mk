ifndef MEGA_MICROS_DIR
$(error MEGA_MICROS_DIR is not set)
endif

CPU?=68030
ARCH?=$(CPU)
TUNE?=$(CPU)

SYSINCDIR?=$(MEGA_MICROS_DIR)/built/include
SYSLIBDIR?=$(MEGA_MICROS_DIR)/built/lib/bios
ROMDISKDIR?=$(MEGA_MICROS_DIR)/src/romdisk/romdisk
ROMDISK_BINDIR?=$(ROMDISKDIR)/bin

LDSCRIPT?=$(MEGA_MICROS_DIR)/built/lib/bios/program.ld
ROM_LDSCRIPT?=none

DEFINES=-DUSEBIOS

FLAGS=-ffreestanding -ffunction-sections -fdata-sections -fomit-frame-pointer	\
      -Wall -Wextra -Werror -Wno-unused-function -pedantic -I$(SYSINCDIR)			\
      -mcpu=$(CPU) -march=$(ARCH) -mtune=$(TUNE) -msoft-float -g -O2 $(DEFINES)
CFLAGS=-std=c11 $(FLAGS)
CXXFLAGS=-std=c++20 -fno-exceptions -fno-rtti $(FLAGS)
GCC_LIBS?=$(shell $(CC) --print-search-dirs \
          | grep libraries:\ = \
          | sed 's/libraries: =/-L/g' \
          | sed 's/:/\/ -L/g')
LIBS=$(EXTRA_LIBS) -lmega -lgcc
ASFLAGS=-mcpu=$(CPU) -march=$(ARCH)
VASMFLAGS=-Felf -m$(CPU) -quiet -Lnf $(DEFINES)
COMMON_LDFLAGS=-L$(SYSLIBDIR) -Map=$(MAP) -z noexecstack --gc-sections --oformat=elf32-m68k $(EXTRA_LDFLAGS)
LDFLAGS=$(COMMON_LDFLAGS) -T$(LDSCRIPT) 
ROM_LDFLAGS=$(COMMON_LDFLAGS) -T$(ROM_LDSCRIPT) 

GCC_68K_PFX=m68k-linux-gnu
CC=$(GCC_68K_PFX)-gcc
CXX=$(GCC_68K_PFX)-g++
AS=$(GCC_68K_PFX)-as
LD=$(GCC_68K_PFX)-ld
NM=$(GCC_68K_PFX)-nm
OBJDUMP=$(GCC_68K_PFX)-objdump
OBJCOPY=$(GCC_68K_PFX)-objcopy
STRIP=$(GCC_68K_PFX)-strip
SIZE=$(GCC_68K_PFX)-size
VASM=vasmm68k_mot
RM=rm -f
CP=cp
MKDIR=mkdir -p

# GCC-version-specific settings
ifneq ($(findstring GCC,$(shell $(CC) --version 2>/dev/null)),)
CC_VERSION:=$(shell $(CC) -dumpfullversion)
CC_MAJOR:=$(firstword $(subst ., ,$(CC_VERSION)))
# If this is GCC 12, 13, or 14, add flag --param=min-pagesize=0 to CFLAGS
ifeq ($(CC_MAJOR),12)
CFLAGS+=--param=min-pagesize=0
endif
ifeq ($(CC_MAJOR),13)
CFLAGS+=--param=min-pagesize=0
endif
ifeq ($(CC_MAJOR),14)
CFLAGS+=--param=min-pagesize=0
endif
endif

# This is dor programs that run directly under the monitor's control, so, since
# the monitor doesn't use the MMU in any way, even though the 68030 has an MMU,
# we set this to false
LD_SUPPORT_MMU?=false
ifneq ($(LD_SUPPORT_MMU),true)
# Saves space in binaries, but will break MMU use
LDFLAGS+=-z max-page-size=16 -z common-page-size=16
endif

# Output config (assume name of directory)
PROGRAM_BASENAME=$(shell basename $(CURDIR))

# Everything the build makes goes in here, so it can be ignored by git
# (and cleaned) as one directory
OBJ_DIR=obj

# Set other output files using output basname
ELF=$(OBJ_DIR)/$(PROGRAM_BASENAME)
SYM=$(OBJ_DIR)/$(PROGRAM_BASENAME).sym
DISASM=$(OBJ_DIR)/$(PROGRAM_BASENAME).dis

# Assume source files in Makefile directory are source files for project
CSOURCES=$(wildcard *.c)
CINCLUDES=$(wildcard *.h)
ASMSOURCES=$(wildcard *.asm)
SOURCES=$(CSOURCES) $(ASMSOURCES)

# Assume each source files makes an object file
OBJECTS=$(addprefix $(OBJ_DIR)/,$(addsuffix .o,$(basename $(SOURCES))))
DEPS=$(OBJECTS:.o=.d)

all: $(ELF)

# Relink when the installed library changes, too (it's linked with -lmega,
# so it's filtered back out of the object list)
$(ELF) : $(OBJECTS) $(SYSLIBDIR)/libmega.a
	$(LD) $(LDFLAGS) $(GCC_LIBS) $(filter-out %.a,$^) $(LIBS) -o $(ELF)
	$(NM) --numeric-sort $(ELF) >$(SYM)
	$(SIZE) $(ELF)

$(DISASM) : $(ELF)
	$(OBJDUMP) --disassemble -S $(ELF) >$(DISASM)

$(OBJECTS): Makefile | $(OBJ_DIR)

$(OBJ_DIR):
	$(MKDIR) $(OBJ_DIR)

# -MMD -MP: write a .d file of the headers each object uses (including the
# library's, in $(SYSINCDIR)), so changing a header rebuilds what uses it
DEPFLAGS=-MMD -MP

$(OBJ_DIR)/%.o : %.c $(CINCLUDES)
	$(CC) -c $(CFLAGS) $(DEPFLAGS) $(EXTRA_CFLAGS) -o $@ $<

$(OBJ_DIR)/%.o : %.cpp
	$(CXX) -c $(CXXFLAGS) $(DEPFLAGS) $(EXTRA_CXXFLAGS) -o $@ $<

$(OBJ_DIR)/%.o : %.S
	$(AS) $(ASFLAGS) -o $@ $<

$(OBJ_DIR)/%.o : %.asm
	$(VASM) $(VASMFLAGS) $(EXTRA_VASMFLAGS) -L $(basename $@).lst -o $@ $<

# remove targets that can be generated by this Makefile
clean:
	$(RM) -r $(OBJ_DIR)

install: all
	$(MKDIR) $(ROMDISK_BINDIR)
	$(CP) $(ELF) $(ROMDISK_BINDIR)/$(PROGRAM_BASENAME)
	$(STRIP) $(ROMDISK_BINDIR)/$(PROGRAM_BASENAME)

# Makefile magic (for "phony" targets that are not real files)
.PHONY: all clean install

-include $(DEPS)
